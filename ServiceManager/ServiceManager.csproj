<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ServiceManager</RootNamespace>
    <AssemblyName>ServiceManager</AssemblyName>
    <ApplicationIcon>Resources and Examples\Settings.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>Service Manager</Product>
    <Company>Kevin Adams</Company>
    <Copyright>Copyright (c) Kevin Adams 2024</Copyright>
    <Description>Windows service management tool for monitoring and controlling services across multiple servers.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krypton.Docking" Version="100.26.1.19" />
    <PackageReference Include="Krypton.Navigator" Version="100.26.1.19" />
<PackageReference Include="Krypton.Toolkit" Version="100.26.1.19" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="9.0.4" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources and Examples\ExampleServerList.json" />
    <Content Include="Themes\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources and Examples\Settings.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="..\Resources\ravenna-3d-icons-by-double-j-design\png\16x16\Reload.png"><LogicalName>Reload16.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\Resources\ravenna-3d-icons-by-double-j-design\png\32x32\Reload.png"><LogicalName>Reload32.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\Resources\ravenna-3d-icons-by-double-j-design\png\16x16\Clock.png"><LogicalName>Clock16.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\Resources\ravenna-3d-icons-by-double-j-design\png\32x32\Clock.png"><LogicalName>Clock32.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\Resources\ravenna-3d-icons-by-double-j-design\png\16x16\Table.png"><LogicalName>Table16.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\Resources\ravenna-3d-icons-by-double-j-design\png\32x32\Table.png"><LogicalName>Table32.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\Resources\ravenna-3d-icons-by-double-j-design\png\16x16\Settings.png"><LogicalName>Settings16.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\Resources\ravenna-3d-icons-by-double-j-design\png\32x32\Settings.png"><LogicalName>Settings32.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\Resources\ravenna-3d-icons-by-double-j-design\png\16x16\Help.png"><LogicalName>Help16.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\Resources\ravenna-3d-icons-by-double-j-design\png\32x32\Help.png"><LogicalName>Help32.png</LogicalName></EmbeddedResource>
  </ItemGroup>

</Project>
